{
  "name": "chara-pinnacle-platform",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @chara-pinnacle/web",
    "build": "npm run build -w @chara-pinnacle/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e -w @chara-pinnacle/web",
    "db:start": "supabase start -x imgproxy,edge-runtime,realtime",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --fail-on error",
    "db:types": "supabase gen types typescript --local --schema public > packages/db-types/src/database.ts",
    "go-live:check": "node scripts/check-go-live.mjs"
  },
  "devDependencies": {
    "supabase": "2.119.0"
  }
}
