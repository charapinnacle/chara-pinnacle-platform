# Names only. Local values go in supabase/functions/.env (gitignored); hosted values are set with
# `npx supabase secrets set --env-file <file>`. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the platform.
EDGE_SHARED_SECRET=
# notify: EMAIL_PROVIDER is resend or null (no default, the function refuses to start without it). RESEND_API_KEY and
# RESEND_WEBHOOK_SECRET (whsec_...) are needed for resend; MAIL_CATCHER_URL is optional for null and sends to the local
# mail catcher. EMAIL_FROM is "Name <address>" on the verified domain; SITE_URL is the origin the emails link to.
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_CATCHER_URL=
EMAIL_FROM=
SITE_URL=
# audit-export: AUDIT_ARCHIVE_PROVIDER is s3 (no default). The bucket is S3 compatible, outside the platform, with Object Lock
# enabled and versioning on. AUDIT_ARCHIVE_ENDPOINT is its origin (https://s3.<region>.amazonaws.com), AUDIT_ARCHIVE_RETAIN_DAYS
# the compliance lock of every file (at least 2191, six years). The key may put objects and may not delete or read them.
AUDIT_ARCHIVE_PROVIDER=
AUDIT_ARCHIVE_ENDPOINT=
AUDIT_ARCHIVE_REGION=
AUDIT_ARCHIVE_BUCKET=
AUDIT_ARCHIVE_ACCESS_KEY_ID=
AUDIT_ARCHIVE_SECRET_ACCESS_KEY=
AUDIT_ARCHIVE_RETAIN_DAYS=
# billing-checkout: BILLING_PROVIDER is stripe or null (no default, the function refuses to start without it).
# STRIPE_SECRET_KEY is needed for stripe only; SITE_URL (above) is the origin of the return addresses.
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
# billing-webhook (same BILLING_PROVIDER and SITE_URL): STRIPE_WEBHOOK_SECRET (whsec_...) is the signing secret of the
# Stripe endpoint and is needed for stripe; BILLING_WEBHOOK_SECRET signs the deliveries of the null provider (local
# stack and CI only). billing-reconcile needs STRIPE_SECRET_KEY and EDGE_SHARED_SECRET.
STRIPE_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=
