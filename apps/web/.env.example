# Local Supabase stack (npm run db:start); copy to .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Server only, never NEXT_PUBLIC_. Keys the hash of the visitor address in the rate limits (a local placeholder here;
# the hosted value is a random string of at least 32 characters, set in the hosting environment, never committed).
VISITOR_HASH_SECRET=local-placeholder-visitor-hash-secret-0123456789
# Reverse proxies in front of the app that each append the address they saw to X-Forwarded-For (the app must not be
# reachable except through them). 1 is also right for the local server, where the browser tests play the proxy.
TRUSTED_PROXY_HOPS=1

# Continue with Google (docs/ARCHITECTURE.md section 6.1). Off unless "true"; turn it on only where the provider is enabled
# in Supabase Auth with the Google client ID and secret (set in the dashboard or the untracked supabase/.env, never here).
GOOGLE_SIGN_IN_ENABLED=false
